{
  "name": "@ona-bola/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "tsx src/scripts/reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0",
    "@ona-bola/shared": "*",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.2",
    "tsx": "4.23.15"
  }
}
