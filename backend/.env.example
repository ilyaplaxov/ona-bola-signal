# Copy to backend/.env (git-ignored) only to change a default.
# Secrets live here and nowhere else: never in the frontend, never in a VITE_* variable.

# API_PORT, not PORT: tools that set PORT for every process would otherwise move the API.
API_PORT=3001
DATABASE_URL=postgres://ona:ona_dev_only@localhost:5433/ona_bola
TEST_DATABASE_URL=postgres://ona:ona_dev_only@localhost:5433/ona_bola_test

# Claude features (phase 5) stay off unless AI_ENABLED=true.
AI_ENABLED=false
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_TIMEOUT_MS=15000
# ANTHROPIC_API_KEY=sk-ant-...

# Sign-in. Both default to on outside production.
# AUTH_DEMO_HEADER: also accept the old x-demo-user-id header (role switcher). Turn off once the
# frontend uses the login page.
AUTH_DEMO_HEADER=
# DEMO_ACCOUNTS: list the demo accounts and their shared password on the login page.
DEMO_ACCOUNTS=

# Telegram bot for patient signals (token from @BotFather). Empty: bot off, /signal page still works.
TELEGRAM_BOT_TOKEN=

# DIMED integration: "stub" (default) queues records and delivers them to a local stand-in;
# "off" queues without sending. Real DIMED access is not available yet.
DIMED_MODE=stub
